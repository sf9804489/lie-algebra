         union1 = Union[Table[{weylgroupActionOfF4OfB3OnEuclid[w,symbolToEuclid[symbolOfType1[a, i]]], {i, w}}, {i, low, upper, 1/2}, {w, weylGroupOfF4OfB3}]];
         union2 = Union[Table[{weylgroupActionOfF4OfB3OnEuclid[w,symbolToEuclid[symbolOfType1[a, i]*{-1, 1, 1, 1, 1}]], {i, Prepend[w, -1]}}, {i, low, upper, 1/2}, {w, weylGroupOfF4OfB3}]];
         Flatten[Union[union1, union2], 1]
         ];

unionOfThisAbcOfType2WithGroupByEuclid[a00_, b00_, low00_, upper00_] :=
