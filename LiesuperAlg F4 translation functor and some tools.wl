(*\:7ed9\:5b9a\:5bf9\:5e94\:7684\:53c2\:6570\:ff0csymbolOfType1\:4e0esymbolofType2\:5206\:522b\:7528\:4e8e\:751f\:6210\:5bf9\:79f0\:548c\:975e\:5bf9\:79f0\:5757\:7684symbol\:ff0cunionOfThisAbcOfType\:7528\:4e8e\:751f\:6210\:7279\:5b9a\:533a\:95f4\:5185\:7684\:6307\:5b9ablock\:5757\:5185\:7684\:6240\:6709symbol*)
symbolOfType1[a0_, c0_] :=
   Module[{a = a0, c = c0},
      Piecewise[{
            {{-3*c, -2*a - c, -2*a + c, -3*c, -c}, c >= 0 && c <= a/2},
            {{-3*c, -2*a - c, -3*c, -2*a + c, -c}, c > a/2 && c <= a},
            {{-3*c, -3*c, -2*a - c, -c, -2*a + c}, c > a}
            }]
      ]
symbolOfType2[a_, b_, c0_] :=
   Module[{c = c0, i = (a + a + b)/3, j = (a + 2*b)/3, k = (a - b)/3},
      Piecewise[{
            {{3*c, 3*c, -2*i + c, 2*k + c, -2*j - c}, c <= -i},
            {{3*c, -2*i + c, 3*c, -2*j - c, 2*k + c}, c > -i && c <= -j/2},
            {{3*c, -2*i + c, -2*j - c, 3*c, 2*k + c}, c > -j/2 && c <= -k/2},
            {{3*c, -2*i + c, -2*j - c, -2*k - c, -3*c}, c > -k/2 && c < 0},
            {{-3*c, -2*i + c, -2*j - c, -2*k - c, -3*c}, c >= 0 && c <= k},
            {{-3*c, -2*j - c, -2*i + c, -3*c, -2*k - c}, c > k && c <= i/2},
            {{-3*c, -2*j - c, -3*c, -2*i + c, -2*k - c}, c > i/2 && c <= j},
            {{-3*c, -3*c, -2*j - c, -2*k - c, -2*i + c}, c > j}
            }]
      ]

(*weyl\:7fa4\:4f5c\:7528\:ff1aweylActionOfF4OfB3OnSymbol\:5bf9symbol\:7684\:5355\:53cd\:5c04,weylActionOfF4OfB3Onfundamental\:5bf9\:57fa\:672c\:6743\:7684\:5355\:53cd\:5c04,weylgroupActionOfF4OfB3OnSymbol\:8ba1\:7b97B3weyl\:7fa4\:4f5c\:7528\:5728symbol\:4e0a\:5f97\:5230\:7684\:7ed3\:679c*)
weylActionOfF4OfB3OnEuclid[B30_, {x0_, y0_, z0_, d0_}] :=
   Module[{B3 = B30, d = d0, x = x0, y = y0, z = z0},
      If[B3 == 0, {x, y, z, d},
         If[B3 == 1, {y, x, z, d},
            If[B3 == 2, {x, z, y, d},
               If[B3 == 3, {x, y, -z, d}, Nothing
                  ]
               ]
            ]
         ]
      ]
weylgroupActionOfF4OfB3OnEuclid[B30_, {x0_, y0_, z0_, d0_}] :=
   Module[{B3 = B30, list = {x0, y0, z0, d0}, i = 0},
      While[i < Length[B3], list = weylActionOfF4OfB3OnEuclid[B3[[Length[B3] - i]], list]; i++;];
      list
      ]

